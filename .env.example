# MongoDB - local (e.g. mongodb://localhost:27017/myhospital)
MONGO_URI=mongodb://localhost:27017/myhospital

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# SMTP (for offline you can point to local SMTP like mailhog, or use your SMTP server)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
FROM_EMAIL="no-reply@myhospital.local"

# Administrator bootstrapping
BOOTSTRAP_ADMIN_EMAIL=admin@myhospital.local
BOOTSTRAP_ADMIN_PASS=AdminPass123!

# Optional: allow immediate report generation via endpoint only if true
ENABLE_MANUAL_REPORT_ENDPOINT=true
